# ── Server ─────────────────────────────────────────────
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug
LOG_DIRECTORY=logs
LOG_RETENTION_DAYS=14
SEQ_URL=http://localhost:5342

# ── Database (PostgreSQL 16) ───────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/lethimcook?schema=public

# ── Redis ──────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── JWT ────────────────────────────────────────────────
JWT_ACCESS_SECRET=your-access-secret-here
JWT_REFRESH_SECRET=your-refresh-secret-here
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── Google OAuth ───────────────────────────────────────
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

# ── CORS ───────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://localhost:3001

# ── SMTP (Nodemailer) ─────────────────────────────────
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=noreply@lethimcook.local
FRONTEND_URL=http://localhost:5173

# ── Sitemap ────────────────────────────────────────────
SITEMAP_BASE_URL=http://localhost:5173
SITEMAP_OUTPUT_DIR=wwwroot

# ── OpenTelemetry ──────────────────────────────────────
OTEL_SERVICE_NAME=lethimcook-api
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# Set only if the collector accepts OTLP metrics. Scrape http://localhost:3000/metrics otherwise.
# OTEL_EXPORTER_OTLP_METRICS_ENDPOINT=http://localhost:4318

# ── S3 / MinIO ────────────────────────────────────────
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=lethimcook
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=us-east-1

# ── Rate Limiting ─────────────────────────────────────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_GENERAL=100
RATE_LIMIT_AUTH=10
RATE_LIMIT_PASSWORD_RESET=5
